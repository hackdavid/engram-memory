# =============================================================================
# Engram SDK -- example environment variables
# Copy to `.env` and fill in values. Do not commit `.env` (it is gitignored).
#
# Config reads the process environment. Export vars in your shell, or configure
# pydantic-settings `env_file=".env"` in your app, or use a process manager that
# loads dotenv files before starting Python.
#
# Live E2E tests (tests/test_live_e2e.py): export ENGRAM_LIVE_TESTS=1 in the
# shell first, then pytest loads this file + engram/.env. Do not set ENGRAM_LIVE_TESTS
# only inside .env unless you also export it — the loader runs after the flag check.
# ENGRAM_LIVE_TESTS=1
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j (required)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional Neo4j
# NEO4J_DATABASE=neo4j
# NEO4J_MAX_POOL_SIZE=50

# -----------------------------------------------------------------------------
# LLM (LiteLLM) -- only these four names; pick model + key for your provider.
# For OpenAI / Anthropic / many others: set MODEL + API_KEY only.
# For Azure OpenAI: also set API_BASE and API_VERSION (your resource URL + API version).
# For Ollama / some local setups: model only may be enough; key can be empty.
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional (e.g. Azure): uncomment and set as needed
# LLM_API_BASE=https://your-resource.openai.azure.com/
# LLM_API_VERSION=2024-02-01

# Optional LLM tuning
# LLM_MAX_TOKENS=4096
# LLM_MAX_RETRIES=3
# LLM_REQUEST_TIMEOUT=90   # seconds; LiteLLM/HTTP (omit for provider default, often 600s)
# LLM_RATE_LIMIT_RPM=60
# LLM_RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
# Required if EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=
# TWO_TIER_EMBEDDING=false

# -----------------------------------------------------------------------------
# Retrieval / scoring / traversal (optional overrides)
# -----------------------------------------------------------------------------
# SCORE_ALPHA=0.5
# SCORE_BETA=0.35
# SCORE_GAMMA=0.15
# TRAVERSAL_DECAY=0.5
# TRAVERSAL_MAX_DEPTH=5
# TRAVERSAL_MIN_SCORE=0.1

# -----------------------------------------------------------------------------
# Background tasks & decay
# -----------------------------------------------------------------------------
# ENABLE_BACKGROUND_TASKS=true
# DECAY_INTERVAL_HOURS=24
# HIERARCHY_REBUILD_INTERVAL_HOURS=24
# WEIGHT_LEARNING_INTERVAL_HOURS=24
# DECAY_FACTOR=0.95
# ARCHIVE_THRESHOLD=0.01

# -----------------------------------------------------------------------------
# Cache & schema
# -----------------------------------------------------------------------------
# CACHE_ENABLED=true
# CACHE_MAX_SIZE=100
# CACHE_TTL_SECONDS=300
# AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# ENABLE_TRACING=false

# -----------------------------------------------------------------------------
# Validation
# -----------------------------------------------------------------------------
# USER_ID_PATTERN=^[a-zA-Z0-9_-]{1,128}$
